---
import camLogo from "../assets/logo.svg?raw";
import { localizePath, getT, DEFAULT_LOCALE, type Locale } from "../i18n/utils";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getT(locale);
---

<a
  href={localizePath("/", locale)}
  class="flex items-center no-underline transition-transform duration-200 hover:scale-105"
  aria-label={t("nav.home")}
  data-astro-prefetch
>
  <div class="logo-svg" set:html={camLogo} />
</a>

<style>
  .logo-svg :global(svg) {
    height: 1.5rem;
    width: auto;
    color: var(--color-fg);
  }
  .logo-svg :global(svg path),
  .logo-svg :global(svg g) {
    fill: currentColor !important;
  }

  @media (min-width: 768px) {
    .logo-svg :global(svg) { height: 2rem; }
  }
  @media (min-width: 1024px) {
    .logo-svg :global(svg) { height: 2.5rem; }
  }
</style>
