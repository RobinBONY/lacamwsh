---
import Logo from "./Logo.astro";
import Menu from "./Menu.astro";
import Navbar from "./Navbar.astro";
import { getT, localizePath, DEFAULT_LOCALE, type Locale } from "../i18n/utils";

interface Props {
  currentPage?: string;
  locale?: Locale;
}

const { currentPage = "", locale = DEFAULT_LOCALE }: Props = Astro.props;
const t = getT(locale);

// "Collections" est actif sur /collections ET sur chaque page de collection
const collectionsActive = currentPage === "all" || (currentPage !== "" && currentPage !== "home");
---

<header
  class="fixed top-0 inset-x-0 z-50 flex items-center justify-between gap-3 px-4 py-3 lg:px-5 lg:py-4 backdrop-blur-md border-b"
  style="background-color: color-mix(in srgb, var(--color-bg) 85%, transparent); border-color: var(--color-border);"
>
  <div class="flex items-center gap-3">
    <Logo locale={locale} />
    <a
      href={localizePath("/collections", locale)}
      class:list={["btn", collectionsActive && "btn--active"]}
      aria-current={collectionsActive ? "page" : undefined}
      data-astro-prefetch
    >
      {t("nav.collections")}
    </a>
  </div>

  <Menu locale={locale} />
</header>

<Navbar currentPage={currentPage} locale={locale} />
