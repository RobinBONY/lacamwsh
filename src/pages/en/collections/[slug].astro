---
import { getCollection } from "astro:content";
import CollectionPage from "../../../components/pages/CollectionPage.astro";

export async function getStaticPaths() {
  const all = await getCollection("collections", ({ data }) => !data.draft);
  return all.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<CollectionPage entry={entry} locale="en" />
