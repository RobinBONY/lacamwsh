---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import { getT, localizePath, type Locale } from "../../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getT(locale);

const allCollections = await getCollection("collections", ({ data }) => !data.draft);
const sortedCollections = allCollections.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const total = String(sortedCollections.length).padStart(2, "0");
---

<MainLayout
  locale={locale}
  currentPage="all"
  title={`${t("collections.title")} — Camille Neto`}
  description={t("about.lead")}
>
  <section class="min-h-dvh px-6 md:px-12 py-16">
    <header
      class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-10 pb-8"
      style="border-bottom:2px solid var(--ink);"
    >
      <div>
        <span class="h-label red mb-4 block">N° 004 — {t("collections.eyebrow")}</span>
        <h1 class="disp" style="font-size:clamp(2.4rem,7vw,5rem);">{t("collections.title")}</h1>
      </div>
      <p class="h-body max-w-sm mono" style="font-size:13px; color:var(--fg-muted);">
        {t("collections.intro")}
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 box">
      {
        sortedCollections.map((entry, i) => (
          <a
            href={localizePath(`/collections/${entry.id}`, locale)}
            class="col-card cell"
            data-astro-prefetch
          >
            <div class="photo-frame relative" style="border:0; border-bottom:1px solid var(--ink);">
              <img
                src={entry.data.cover}
                alt={entry.data.title}
                loading="lazy"
                decoding="async"
                class="w-full object-cover block"
                style="aspect-ratio:4/5;"
              />
            </div>
            <div class="flex justify-between items-baseline px-5 pt-5 pb-2 gap-3">
              <h2 class="disp" style="font-size:1.6rem;">{entry.data.title}</h2>
              <span class="mono" style="font-size:11px; color:#666; white-space:nowrap;">
                {`N° ${String(i + 1).padStart(2, "0")}`}
              </span>
            </div>
            {entry.data.description && (
              <p class="px-5 pb-5 mono" style="font-size:12px; color:#666;">
                {entry.data.description}
              </p>
            )}
          </a>
        ))
      }
    </div>

    <div class="flex justify-between items-end mt-8 mono" style="font-size:11px; color:#666;">
      <span>Index — {total} / {total} {t("collections.meta")}</span>
      <span>↓</span>
    </div>
  </section>
</MainLayout>

<style>
  .col-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 350ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .col-card:hover {
    transform: translateY(-6px);
  }
  .col-card:hover :global(.photo-frame) {
    border-color: var(--red);
  }
  .col-card :global(.photo-frame) {
    overflow: hidden;
  }
  .col-card :global(.photo-frame img) {
    transition: transform 500ms ease;
  }
  .col-card:hover :global(.photo-frame img) {
    transform: scale(1.03);
  }
</style>
