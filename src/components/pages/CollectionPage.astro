---
import { render, type CollectionEntry } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import { getT, formatDate, localizePath, type Locale } from "../../i18n/utils";

interface Props {
  entry: CollectionEntry<"collections">;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const t = getT(locale);
const { Content } = await render(entry);

// JSON-LD ImageGallery pour cette page collection
const galleryJsonLd = {
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  name: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date.toISOString(),
  associatedMedia: entry.data.photos.map((src) => ({
    "@type": "ImageObject",
    contentUrl: src,
  })),
};

const photoCount = entry.data.photos.length;
const tags = entry.data.tags ?? [];
---

<MainLayout
  locale={locale}
  currentPage={entry.id}
  title={`${entry.data.title} — Camille Neto`}
  description={entry.data.description ?? t("about.lead")}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(galleryJsonLd)} />

  <article class="min-h-dvh px-6 md:px-12 py-16">
    {/* Fil d'Ariane */}
    <div class="flex items-center gap-4 mb-8 mono" style="font-size:12px; color:#666;">
      <a href={localizePath("/collections", locale)}>← {t("collection.back")}</a>
      <span>/</span>
      <span class="red">{entry.data.title}</span>
    </div>

    {/* En-tête 12 colonnes */}
    <header
      class="grid md:grid-cols-12 gap-8 items-end pb-10 mb-10"
      style="border-bottom:2px solid var(--ink);"
    >
      <h1 class="disp md:col-span-8" style="font-size:clamp(2.4rem,7vw,5rem);">{entry.data.title}</h1>
      <div class="md:col-span-4 mono space-y-2" style="font-size:13px;">
        <div>
          <span class="h-label" style="color:#777; font-size:10px;">{t("collection.metaPeriodLabel")}</span><br />
          {formatDate(entry.data.date, locale)}
        </div>
        <div>
          <span class="h-label" style="color:#777; font-size:10px;">{t("collection.metaFormatLabel")}</span><br />
          {t("collection.metaFormat")}
        </div>
        {tags.length > 0 && (
          <div>
            <span class="h-label" style="color:#777; font-size:10px;">{t("collection.metaSeriesLabel")}</span><br />
            {tags.join(" · ")}
          </div>
        )}
      </div>
    </header>

    {entry.data.description && (
      <p class="max-w-2xl h-body mb-6" style="color:var(--fg-muted);">{entry.data.description}</p>
    )}
    <div class="max-w-2xl h-body mb-12" style="color:var(--fg-muted);">
      <Content />
    </div>

    {/* Galerie planche-contact — ordre randomisé côté client */}
    <div class="gallery box" data-photos={JSON.stringify(entry.data.photos)}></div>

    <div
      class="flex justify-between items-center mt-12 pt-8"
      style="border-top:2px solid var(--ink);"
    >
      <span class="mono" style="font-size:11px; color:#666;">
        {photoCount} {t("collection.platesShown")}
      </span>
    </div>
  </article>

  <div
    id="lightbox"
    class="lightbox"
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
  >
    <button class="btn lightbox-ctrl" style="position:absolute; top:24px; right:24px;" aria-label="Close" data-lightbox-action="close">✕</button>
    <button class="btn lightbox-ctrl" style="position:absolute; left:24px; top:50%; transform:translateY(-50%);" aria-label="Previous" data-lightbox-action="prev">‹</button>
    <img class="lightbox-image" alt="" />
    <button class="btn lightbox-ctrl" style="position:absolute; right:24px; top:50%; transform:translateY(-50%);" aria-label="Next" data-lightbox-action="next">›</button>
    <span class="lightbox-counter mono" style="position:absolute; bottom:24px; left:24px; font-size:12px; color:#aaa;"></span>
  </div>
</MainLayout>

<script>
  function shuffle<T>(array: T[]): T[] {
    const a = [...array];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  function renderGallery(container: HTMLElement) {
    const raw = container.getAttribute("data-photos");
    if (!raw) return;
    const photos: string[] = JSON.parse(raw);
    const shuffled = shuffle(photos);
    container.innerHTML = shuffled
      .map(
        (src, i) => `
          <button type="button" class="gallery-item cell" data-lightbox-index="${i}">
            <img src="${src}" alt="" loading="lazy" decoding="async" />
            <span class="gcap mono">${String(i + 1).padStart(3, "0")}</span>
          </button>
        `,
      )
      .join("");
    setupLightboxThumbnails(shuffled);
  }

  let lightboxPhotos: string[] = [];
  let lightboxIndex = 0;

  function setupLightboxThumbnails(photos: string[]) {
    lightboxPhotos = photos;
    document.querySelectorAll<HTMLButtonElement>(".gallery-item").forEach((btn) => {
      btn.addEventListener("click", () => {
        const idx = parseInt(btn.getAttribute("data-lightbox-index") || "0", 10);
        openLightbox(idx);
      });
    });
  }

  function openLightbox(idx: number) {
    lightboxIndex = idx;
    const lb = document.getElementById("lightbox");
    if (!lb) return;
    lb.setAttribute("aria-hidden", "false");
    lb.classList.add("open");
    updateLightboxImage();
    document.body.style.overflow = "hidden";
  }

  function closeLightbox() {
    const lb = document.getElementById("lightbox");
    if (!lb) return;
    lb.setAttribute("aria-hidden", "true");
    lb.classList.remove("open");
    document.body.style.overflow = "";
  }

  function updateLightboxImage() {
    const img = document.querySelector<HTMLImageElement>(".lightbox-image");
    const counter = document.querySelector<HTMLElement>(".lightbox-counter");
    if (!img || lightboxPhotos.length === 0) return;
    img.src = lightboxPhotos[lightboxIndex];
    if (counter) counter.textContent = `${lightboxIndex + 1} / ${lightboxPhotos.length}`;
  }

  function nextLightbox() {
    lightboxIndex = (lightboxIndex + 1) % lightboxPhotos.length;
    updateLightboxImage();
  }
  function prevLightbox() {
    lightboxIndex = (lightboxIndex - 1 + lightboxPhotos.length) % lightboxPhotos.length;
    updateLightboxImage();
  }

  function wireLightboxControls() {
    const lb = document.getElementById("lightbox");
    if (!lb || lb.dataset.wired === "true") return;
    lb.dataset.wired = "true";

    lb.querySelectorAll<HTMLButtonElement>("[data-lightbox-action]").forEach((btn) => {
      const action = btn.getAttribute("data-lightbox-action");
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        if (action === "close") closeLightbox();
        if (action === "next") nextLightbox();
        if (action === "prev") prevLightbox();
      });
    });

    lb.addEventListener("click", (e) => { if (e.target === lb) closeLightbox(); });
    document.addEventListener("keydown", (e) => {
      if (lb.getAttribute("aria-hidden") === "true") return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowRight") nextLightbox();
      if (e.key === "ArrowLeft") prevLightbox();
    });
  }

  document.querySelectorAll<HTMLElement>(".gallery").forEach(renderGallery);
  wireLightboxControls();
  document.addEventListener("astro:after-swap", () => {
    document.querySelectorAll<HTMLElement>(".gallery").forEach(renderGallery);
    wireLightboxControls();
  });
</script>

<style>
  .space-y-2 > * + * { margin-top: 8px; }

  /* Galerie masonry — planche-contact */
  .gallery {
    column-count: 1;
    column-gap: 0;
  }
  @media (min-width: 720px) { .gallery { column-count: 2; } }
  @media (min-width: 1100px) { .gallery { column-count: 3; } }

  .gallery :global(.gallery-item) {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    break-inside: avoid;
    background: var(--paper);
    cursor: zoom-in;
    appearance: none;
    overflow: hidden;
  }
  .gallery :global(.gallery-item img) {
    width: 100%;
    height: auto;
    display: block;
    filter: grayscale(1) contrast(1.05);
    transition: filter 300ms ease, transform 500ms ease;
  }
  .gallery :global(.gallery-item:hover img) {
    filter: grayscale(0) contrast(1);
    transform: scale(1.02);
  }
  .gallery :global(.gcap) {
    position: absolute;
    bottom: 8px;
    left: 10px;
    font-size: 10px;
    color: var(--paper);
    mix-blend-mode: difference;
    letter-spacing: 0.1em;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    background: rgba(13, 13, 13, 0.97);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 200;
    padding: 5vh;
  }
  .lightbox.open { display: flex; }
  .lightbox .lightbox-image {
    max-width: 92vw;
    max-height: 88vh;
    object-fit: contain;
    filter: grayscale(1);
    user-select: none;
  }
  .lightbox :global(.lightbox-ctrl) {
    border-color: var(--paper);
    color: var(--paper);
    background: transparent;
    width: 3rem;
    height: 3rem;
    padding: 0;
    font-size: 1.25rem;
  }
  .lightbox :global(.lightbox-ctrl:hover) {
    background: var(--paper);
    color: var(--ink);
  }
</style>
