---
import { getCollection } from "astro:content";
import { localizePath, DEFAULT_LOCALE, type Locale } from "../i18n/utils";

interface Props {
  currentPage?: string;
  locale?: Locale;
}

const { currentPage = "", locale = DEFAULT_LOCALE }: Props = Astro.props;

const allCollections = await getCollection("collections", ({ data }) => data.draft !== true);

const sortedCollections = allCollections.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

interface Tab {
  href: string;
  label: string;
  num: string;
  active: boolean;
}

const tabs: Tab[] = sortedCollections.map((entry, i) => ({
  href: localizePath(`/collections/${entry.id}`, locale),
  label: entry.data.title,
  num: String(i + 1).padStart(2, "0"),
  active: currentPage === entry.id,
}));
---

<nav class="tab-stack" aria-label="Collections">
  {
    tabs.map((tab) => (
      <a
        href={tab.href}
        class:list={["tab", tab.active && "active"]}
        aria-current={tab.active ? "page" : undefined}
        data-astro-prefetch
      >
        <span class="num">{tab.num}</span>
        <span>{tab.label}</span>
      </a>
    ))
  }
</nav>

<style>
  .tab-stack {
    position: fixed;
    top: var(--nav-h);
    left: 0;
    height: calc(100vh - var(--nav-h));
    z-index: 40;
    display: flex;
    flex-direction: column;
    width: var(--rail-w);
    border-right: 1.5px solid var(--ink);
    background: var(--paper);
    overflow-y: auto;
    scrollbar-width: none;
  }
  .tab-stack::-webkit-scrollbar { display: none; }

  .tab {
    flex: 1 0 auto;
    min-height: 9rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--ink);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 700;
    text-decoration: none;
    color: var(--ink);
    cursor: pointer;
    transition: background 180ms, color 180ms;
    padding: 14px 0;
    gap: 10px;
  }
  .tab:last-child { border-bottom: none; }
  .tab:hover { background: var(--ink); color: var(--paper); }
  .tab.active {
    background: var(--red);
    color: var(--paper);
    border-color: var(--red);
  }
  .tab .num {
    font-size: 9px;
    opacity: 0.6;
    letter-spacing: 0.1em;
  }

  /* ============================================================
     MOBILE (< 900px) — bandeau bas horizontal
     ============================================================ */
  @media (max-width: 899px) {
    .tab-stack {
      top: auto;
      right: 0;
      bottom: 0;
      left: 0;
      width: auto;
      height: auto;
      flex-direction: row;
      border-right: none;
      border-top: 1.5px solid var(--ink);
      overflow-x: auto;
      overflow-y: hidden;
    }
    .tab {
      flex: 0 0 auto;
      min-height: 0;
      writing-mode: horizontal-tb;
      transform: none;
      border-bottom: none;
      border-right: 1px solid var(--ink);
      padding: 12px 18px;
      white-space: nowrap;
    }
    .tab:last-child { border-right: none; }
  }
</style>
