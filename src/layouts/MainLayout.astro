---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Panel from "../components/Panel.astro";
import SEO from "../components/ui/SEO.astro";
import { getT, asset, DEFAULT_LOCALE, type Locale } from "../i18n/utils";

interface Props {
  locale?: Locale;
  title?: string;
  description?: string;
  currentPage?: string;
}

const {
  locale = (Astro.currentLocale as Locale) ?? DEFAULT_LOCALE,
  title,
  description,
  currentPage = "",
} = Astro.props;

const t = getT(locale);
const pageTitle = title ?? `Camille Neto — ${t("about.title")}`;
const pageDescription = description ?? t("about.lead");
---

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={asset("favicon.svg")} />
    <meta name="generator" content={Astro.generator} />

    {/* Typographie Archivo — Swiss modernist */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Archivo+Black&display=swap"
      rel="stylesheet"
    />

    <SEO locale={locale} title={pageTitle} description={pageDescription} />
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">{t("nav.skip")}</a>
    <Panel currentPage={currentPage} locale={locale} />
    <main
      id="main"
      class="main-shift h-dvh w-full overflow-y-auto scroll-smooth [scroll-snap-type:y_mandatory]"
    >
      <slot />
    </main>

    <style>
      /* Décalage du contenu sous la barre fixe + le rail latéral */
      .main-shift {
        padding-top: var(--nav-h);
      }
      @media (min-width: 900px) {
        .main-shift {
          padding-left: var(--rail-w);
        }
      }
    </style>
  </body>
</html>
