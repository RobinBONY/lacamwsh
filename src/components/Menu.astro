---
import { getT, LOCALES, DEFAULT_LOCALE, switchLocale, type Locale } from "../i18n/utils";

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getT(locale);

const currentPath = Astro.url.pathname;
const langLinks = LOCALES.map((loc) => ({
  locale: loc,
  href: switchLocale(currentPath, loc),
  label: t(`menu.lang.${loc}`),
}));
---

<div class="lang-wrap relative flex items-stretch">
  <button
    id="lang-toggle"
    type="button"
    class="nav-cell nav-btn h-label"
    aria-label="Language"
    aria-haspopup="true"
    aria-expanded="false"
  >
    {locale.toUpperCase()}
  </button>

  <ul
    id="lang-menu"
    class="lang-menu"
    role="menu"
    hidden
  >
    {
      langLinks.map((link) => (
        <li>
          <a
            href={link.href}
            role="menuitem"
            data-astro-prefetch
            class:list={["lang-item h-label", link.locale === locale && "is-current"]}
          >
            <span class="lang-code">{link.locale.toUpperCase()}</span>
            <span>{link.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .lang-menu {
    position: absolute;
    top: 100%;
    right: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    min-width: 10rem;
    z-index: 100;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    border-top: none;
  }
  .lang-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    text-decoration: none;
    color: var(--ink);
    transition: background 150ms, color 150ms;
  }
  .lang-item:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .lang-item.is-current {
    color: var(--red);
  }
  .lang-item.is-current:hover {
    color: var(--paper);
  }
  .lang-code {
    opacity: 0.6;
    min-width: 1.8rem;
  }
</style>

<script>
  function wireLangMenu() {
    const langToggle = document.getElementById("lang-toggle");
    const langMenu = document.getElementById("lang-menu");
    if (!langToggle || !langMenu) return;
    if ((langToggle as HTMLElement).dataset.wired === "true") return;
    (langToggle as HTMLElement).dataset.wired = "true";

    langToggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const isHidden = langMenu.hasAttribute("hidden");
      if (isHidden) {
        langMenu.removeAttribute("hidden");
        langToggle.setAttribute("aria-expanded", "true");
      } else {
        langMenu.setAttribute("hidden", "");
        langToggle.setAttribute("aria-expanded", "false");
      }
    });

    document.addEventListener("click", (e) => {
      if (!langMenu.contains(e.target as Node) && e.target !== langToggle) {
        langMenu.setAttribute("hidden", "");
        langToggle.setAttribute("aria-expanded", "false");
      }
    });
  }
  wireLangMenu();
  document.addEventListener("astro:after-swap", wireLangMenu);
</script>
