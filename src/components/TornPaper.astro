---
/**
 * <TornPaper /> — Wrapper qui donne un look « morceau de papier déchiré ».
 *
 * Utilise :
 *  - clip-path: polygon() avec points irréguliers pré-calculés (5 variantes)
 *  - background avec grain SVG (texture papier subtile)
 *  - filter: drop-shadow() pour une ombre qui suit le bord déchiré
 *
 * Props:
 *  - variant : 1..5 (choix d'un des 5 patterns de déchirure), random si non précisé
 *  - tone    : 'paper' (ivoire) | 'paper-soft' (ivoire grisé) | 'ink' (noir)
 *  - rotation: angle de rotation en degrés (subtil : -3 à +3 conseillé)
 *  - class   : classes additionnelles
 */
interface Props {
  variant?: 1 | 2 | 3 | 4 | 5;
  tone?: "paper" | "paper-soft" | "ink";
  rotation?: number;
  class?: string;
}

const {
  variant = (Math.floor(Math.random() * 5) + 1) as 1 | 2 | 3 | 4 | 5,
  tone = "paper",
  rotation = 0,
  class: className = "",
}: Props = Astro.props;
---

<div
  class:list={["torn", `torn--v${variant}`, `torn--${tone}`, className]}
  style={`--torn-rotation: ${rotation}deg`}
>
  <div class="torn-inner">
    <slot />
  </div>
</div>

<style is:global>
  /* ============================================================
     5 patterns de déchirure (clip-path polygon)
     Chaque pattern décrit le contour d'un rectangle avec des
     points irréguliers — comme une feuille déchirée à la main.
     ============================================================ */

  .torn--v1 {
    clip-path: polygon(
      1% 3%, 6% 1%, 13% 4%, 22% 0%, 30% 3%, 42% 1%, 53% 4%, 64% 1%, 75% 3%,
      86% 1%, 96% 4%, 99% 7%,
      97% 18%, 100% 28%, 98% 41%, 100% 54%, 97% 66%, 100% 78%, 98% 91%, 99% 97%,
      92% 99%, 81% 96%, 70% 99%, 58% 97%, 45% 100%, 32% 97%, 20% 100%, 9% 97%, 2% 99%,
      0% 92%, 3% 80%, 0% 68%, 2% 55%, 0% 42%, 3% 28%, 0% 16%, 2% 8%
    );
  }

  .torn--v2 {
    clip-path: polygon(
      2% 1%, 10% 4%, 18% 1%, 28% 3%, 38% 1%, 49% 4%, 60% 0%, 70% 3%, 82% 1%,
      91% 3%, 98% 1%,
      100% 12%, 97% 24%, 99% 36%, 96% 48%, 99% 60%, 97% 72%, 100% 84%, 98% 96%,
      90% 99%, 79% 97%, 68% 100%, 56% 97%, 44% 100%, 33% 97%, 22% 100%, 11% 97%, 3% 100%,
      1% 90%, 3% 78%, 0% 65%, 2% 52%, 0% 40%, 3% 27%, 1% 14%, 0% 5%
    );
  }

  .torn--v3 {
    clip-path: polygon(
      3% 2%, 14% 0%, 25% 3%, 36% 1%, 47% 4%, 58% 0%, 68% 3%, 79% 1%, 89% 4%, 97% 2%,
      99% 11%, 96% 22%, 100% 33%, 97% 45%, 100% 57%, 96% 69%, 99% 81%, 97% 92%, 99% 98%,
      88% 100%, 76% 97%, 64% 100%, 51% 96%, 39% 100%, 26% 97%, 14% 100%, 4% 96%,
      0% 88%, 2% 76%, 0% 63%, 3% 50%, 0% 37%, 2% 24%, 0% 12%, 1% 5%
    );
  }

  .torn--v4 {
    clip-path: polygon(
      0% 5%, 8% 2%, 17% 5%, 26% 0%, 36% 4%, 46% 1%, 56% 3%, 67% 0%, 77% 4%, 88% 1%, 96% 3%,
      99% 14%, 97% 26%, 100% 38%, 98% 51%, 100% 63%, 97% 76%, 99% 88%, 97% 96%,
      87% 99%, 76% 96%, 65% 100%, 53% 97%, 41% 99%, 29% 96%, 17% 100%, 7% 97%, 1% 99%,
      3% 87%, 0% 74%, 2% 62%, 0% 49%, 3% 36%, 0% 23%, 2% 11%
    );
  }

  .torn--v5 {
    clip-path: polygon(
      4% 0%, 12% 4%, 21% 1%, 33% 3%, 44% 0%, 55% 4%, 65% 1%, 76% 4%, 87% 0%, 95% 3%, 100% 6%,
      96% 15%, 100% 27%, 97% 39%, 99% 51%, 96% 62%, 100% 74%, 97% 85%, 100% 95%,
      91% 98%, 80% 100%, 69% 97%, 57% 100%, 46% 96%, 34% 99%, 23% 96%, 12% 100%, 3% 97%,
      0% 89%, 2% 77%, 0% 64%, 3% 51%, 1% 38%, 2% 25%, 0% 13%, 1% 4%
    );
  }

  /* ============================================================
     Base
     Les papiers prennent TOUJOURS la couleur opposée au canvas
     (--color-fg) → ils ressortent dans les deux thèmes :
       Light : canvas ivoire → papiers noirs
       Dark  : canvas noir   → papiers ivoires
     ============================================================ */
  .torn {
    --paper-bg: var(--color-fg);
    --paper-fg: var(--color-bg);
    position: relative;
    display: block;
    background-color: var(--paper-bg);
    color: var(--paper-fg);
    transform: rotate(var(--torn-rotation, 0deg));
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.25));
    transition: transform 0.4s ease, filter 0.4s ease;
  }

  /* Tons disponibles (toujours contrastés avec le canvas) */
  .torn--paper {
    --paper-bg: var(--color-fg);
    --paper-fg: var(--color-bg);
  }
  .torn--paper-soft {
    --paper-bg: color-mix(in srgb, var(--color-fg) 90%, var(--color-bg));
    --paper-fg: var(--color-bg);
  }
  /* Ton "ink" = blend avec le canvas (subtil, pour cartes secondaires) */
  .torn--ink {
    --paper-bg: var(--color-bg-alt);
    --paper-fg: var(--color-fg);
  }

  /* ============================================================
     Texture grain papier — gray-noise + overlay
     Fonctionne sur fonds clairs ET sombres (le gris se "voit"
     comme légère variation tonale dans les deux cas)
     ============================================================ */
  .torn {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix values='0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0 0.5  0 0 0 0.45 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    background-size: 240px 240px;
    background-blend-mode: overlay;
  }

  .torn-inner {
    position: relative;
    width: 100%;
    height: 100%;
  }
</style>
