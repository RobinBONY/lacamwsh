---
import {
  LOCALES,
  switchLocale,
  stripLocaleFromPath,
  localizePath,
  type Locale,
} from "../../i18n/utils";

interface Props {
  locale: Locale;
  title: string;
  description: string;
}

const { locale, title, description }: Props = Astro.props;

// Hreflang : on génère une URL absolue par locale, base path inclus.
// `Astro.url.pathname` contient déjà le base path en production (ex: /lacamwsh/en/collections).
// switchLocale() le gère via stripBase + addBase.
const currentPath = Astro.url.pathname;

const alternates = LOCALES.map((loc) => {
  const path = switchLocale(currentPath, loc);
  return {
    locale: loc,
    href: new URL(path, Astro.site).toString(),
  };
});

// Chemin x-default (locale par défaut, sans préfixe de langue)
const xDefaultPath = localizePath(stripLocaleFromPath(currentPath), undefined);
const xDefaultHref = new URL(xDefaultPath, Astro.site).toString();

// URL canonique (avec base path)
const canonical = new URL(currentPath, Astro.site).toString();

// JSON-LD structuré : Person
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Camille Neto",
  jobTitle: "Photographer",
  url: canonical,
  sameAs: ["https://instagram.com/camille.neto"],
  knowsLanguage: LOCALES,
  workLocation: [
    { "@type": "Place", name: "Paris, France" },
    { "@type": "Place", name: "Lisbon, Portugal" },
  ],
};
---

<title>{title}</title>
<meta name="description" content={description} />

{/* Open Graph */}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:locale" content={locale} />
<meta property="og:url" content={canonical} />

{/* Twitter */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

{/* hreflang : URLs absolues (recommandation Google) */}
{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.locale} href={alt.href} />
))}
<link rel="alternate" hreflang="x-default" href={xDefaultHref} />

{/* Canonical */}
<link rel="canonical" href={canonical} />

{/* JSON-LD structured data */}
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
